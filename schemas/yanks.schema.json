{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dactechstudio/pyrun-wheels/schemas/yanks-v1.json",
  "title": "PyRun package yank policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "yanked"],
  "properties": {
    "schemaVersion": {"const": 1},
    "yanked": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "reason"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 64},
          "reason": {"type": "string", "minLength": 1, "maxLength": 255}
        }
      }
    }
  }
}
