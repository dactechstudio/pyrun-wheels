{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dactechstudio/pyrun-wheels/schemas/build-recipe-v1.json",
  "title": "PyRun Android wheel build recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "python_tag", "android_api_min", "abis", "license", "source_url", "build", "runtime_dependencies", "sbom"],
  "properties": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "python_tag": {"const": "cp313-cp313"},
    "android_api_min": {"type": "integer", "minimum": 25},
    "abis": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["arm64_v8a", "x86_64"]}
    },
    "license": {"type": "string", "pattern": "^[A-Z0-9.+-]+$"},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cibuildwheel", "ndk", "setuptools", "wheel"],
      "properties": {
        "cibuildwheel": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "ndk": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "setuptools": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "wheel": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"}
      }
    },
    "runtime_dependencies": {"type": "array", "items": {"type": "string"}},
    "sbom": {"type": "string", "pattern": "^sbom/[^ ]+\\.json$"}
  }
}
