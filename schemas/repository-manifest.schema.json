{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyrun.dactechstudio.com/schemas/repository-manifest-v1.json",
  "title": "PyRun Android wheel repository manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRevision", "pythonVersion", "androidMinApi", "ndkVersion", "artifacts"],
  "properties": {
    "schemaVersion": {"const": 1},
    "sourceRevision": {"type": "string", "minLength": 7, "maxLength": 64, "pattern": "^[a-fA-F0-9]+$"},
    "pythonVersion": {"const": "3.13"},
    "androidMinApi": {"type": "integer", "minimum": 25},
    "ndkVersion": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "pythonTag", "abi", "androidApi", "filename", "sha256", "url", "sourceUrl", "sourceTreeSha256", "recipePath", "recipeSha256", "license", "sbomPath", "sbomSha256", "playRuntimeInstallAllowed"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,199}$"},
          "version": {"type": "string", "minLength": 1, "maxLength": 64},
          "pythonTag": {"const": "cp313-cp313"},
          "abi": {"enum": ["arm64_v8a", "x86_64"]},
          "androidApi": {"type": "integer", "minimum": 25},
          "filename": {"type": "string", "pattern": "^[A-Za-z0-9_.+-]+\\.whl$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "url": {"type": "string", "format": "uri-reference", "minLength": 1},
          "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://"},
          "sourceTreeSha256": {"$ref": "#/$defs/sha256"},
          "recipePath": {"type": "string", "pattern": "^recipes/[^ ]+\\.json$"},
          "recipeSha256": {"$ref": "#/$defs/sha256"},
          "license": {"type": "string", "pattern": "^[A-Z0-9.+-]+$"},
          "sbomPath": {"type": "string", "pattern": "^sbom/[^ ]+\\.json$"},
          "sbomSha256": {"$ref": "#/$defs/sha256"},
          "playRuntimeInstallAllowed": {"const": false}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
